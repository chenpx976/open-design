# Image published by deploy/scripts/publish-images.sh.
OPEN_DESIGN_IMAGE=docker.io/vanjayak/open-design:latest

# Host port exposed on 127.0.0.1 by docker compose.
# Keep Compose bound to localhost; use an authenticated reverse proxy, SSH tunnel,
# or VPN before exposing Open Design remotely.
OPEN_DESIGN_PORT=7456

# Comma-separated browser origins allowed to call /api when deployed behind a
# domain, public IP, or reverse proxy, e.g. http://203.0.113.10:7456,https://od.example.com.
OPEN_DESIGN_ALLOWED_ORIGINS=

# Container memory limit. The idle service has been verified around 18-22 MiB.
# Raise this for large exports, concurrent agent runs, or heavy upload workflows.
OPEN_DESIGN_MEM_LIMIT=384m

# Agent runtime mode for the API container. The recommended Compose experience
# uses the worker profile below: API writes jobs, workers run the Pi SDK.
OPEN_DESIGN_AGENT_RUNTIME=sqlite-worker

# Worker queue backend.
# - redis: recommended cluster-like queue for the worker profile.
# - sqlite: single-host fallback stored in /app/.od/app.sqlite.
OPEN_DESIGN_AGENT_JOB_QUEUE=redis
OPEN_DESIGN_AGENT_REDIS_URL=redis://redis:6379/0

# Run/event persistence backend.
# - postgres: recommended cluster-like event history for API/worker split.
# - sqlite: single-host fallback stored in /app/.od/app.sqlite.
OPEN_DESIGN_AGENT_RUN_STORE=postgres
OPEN_DESIGN_AGENT_POSTGRES_URL=postgres://open_design:open_design@postgres:5432/open_design

# Worker lease/retry controls.
OPEN_DESIGN_AGENT_WORKER_MAX_ATTEMPTS=3
OPEN_DESIGN_AGENT_WORKER_LEASE_MS=120000
OPEN_DESIGN_AGENT_WORKER_HEARTBEAT_MS=30000
OPEN_DESIGN_AGENT_WORKER_MAX_JOB_MS=900000

# Worker memory limit used by `docker compose --profile worker up`.
OPEN_DESIGN_WORKER_MEM_LIMIT=768m

# Node.js heap cap inside the container.
NODE_OPTIONS=--max-old-space-size=192
